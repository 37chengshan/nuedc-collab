{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "schemaVersion",
    "id",
    "title",
    "status",
    "author",
    "module",
    "description",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "recordType": {
      "const": "idea"
    },
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^A-\\d{8}-[0-9A-HJKMNP-TV-Z]{4}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "discarded"
      ]
    },
    "author": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 39
    },
    "owner": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 39
    },
    "module": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "recordType",
    "schemaVersion",
    "githubUsername",
    "roles",
    "responsibilities",
    "status",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "recordType": {
      "const": "member"
    },
    "schemaVersion": {
      "const": 1
    },
    "githubUsername": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?$",
      "minLength": 1,
      "maxLength": 39
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "coordinator",
          "hardware",
          "firmware",
          "vision",
          "mechanical",
          "testing",
          "documentation"
        ]
      }
    },
    "responsibilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
